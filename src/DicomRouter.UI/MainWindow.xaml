<Window x:Class="DicomRouter.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DicomRouter.UI" Title="ImageYeeter · DICOM Router" Height="900" Width="1500" MinHeight="700" MinWidth="1100" Background="#10161D" Foreground="#E7EDF2" FontFamily="Segoe UI">
<Window.Resources>
<SolidColorBrush x:Key="Panel" Color="#17212B"/><SolidColorBrush x:Key="Panel2" Color="#1D2A35"/><SolidColorBrush x:Key="Muted" Color="#8FA2B2"/><SolidColorBrush x:Key="Accent" Color="#52D6A1"/><SolidColorBrush x:Key="Warn" Color="#F2B84B"/><SolidColorBrush x:Key="Danger" Color="#EF6B73"/>
<Style TargetType="Button"><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="12,7"/><Setter Property="Background" Value="#263746"/><Setter Property="Foreground" Value="#E7EDF2"/><Setter Property="BorderBrush" Value="#3A5162"/></Style>
<Style TargetType="DataGrid"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Foreground" Value="#E7EDF2"/><Setter Property="BorderBrush" Value="#2D414F"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="RowBackground" Value="#17212B"/><Setter Property="AlternatingRowBackground" Value="#1B2731"/></Style>
<Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#263746"/><Setter Property="Foreground" Value="#B9CBD6"/><Setter Property="Padding" Value="10,8"/></Style>
</Window.Resources>
<Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Grid.Row="0" Margin="0,0,0,18"><StackPanel><TextBlock Text="IMAGEYEETER" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="DICOM ROUTING CONTROL PLANE" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="SCP  ●  " Foreground="{StaticResource Accent}" FontSize="16"/><TextBlock Text="{Binding ScpState}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel></DockPanel>
<Border Grid.Row="1" Background="{StaticResource Panel}" Padding="14" Margin="0,0,0,16"><DockPanel><StackPanel Orientation="Horizontal"><Button Content="START SCP" Command="{Binding StartScpCommand}"/><Button Content="STOP" Command="{Binding StopScpCommand}"/><TextBlock Text="AE TITLE" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,5,0"/><TextBox Text="{Binding LocalAeTitle}" Width="120" Padding="6"/><TextBlock Text="ENDPOINT" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,5,0"/><TextBox Text="{Binding LocalIp}" Width="110" Padding="6"/><TextBox Text="{Binding LocalPort}" Width="65" Padding="6"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="native TCP DICOM  /  operator console" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel></Border>
<TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
<TabItem Header="DASHBOARD"><ScrollViewer><StackPanel Margin="0,12,0,0"><UniformGrid Columns="4" Margin="0,0,0,16"><Border Background="{StaticResource Panel}" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="SCP STATUS" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ScpState}" FontSize="24" Foreground="{StaticResource Accent}"/></StackPanel></Border><Border Background="{StaticResource Panel}" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="ACTIVE ASSOCIATIONS" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ActiveAssociations}" FontSize="24"/></StackPanel></Border><Border Background="{StaticResource Panel}" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="QUEUE DEPTH" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding QueueDepth}" FontSize="24" Foreground="{StaticResource Warn}"/></StackPanel></Border><Border Background="{StaticResource Panel}" Padding="18"><StackPanel><TextBlock Text="THROUGHPUT MB/S" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Throughput, StringFormat={}{0:0.00}}" FontSize="24"/></StackPanel></Border></UniformGrid><UniformGrid Columns="3" Margin="0,0,0,16"><Border Background="{StaticResource Panel2}" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="INCOMING IMAGES" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding IncomingImages}" FontSize="32"/></StackPanel></Border><Border Background="{StaticResource Panel2}" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="OUTGOING IMAGES" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding OutgoingImages}" FontSize="32"/></StackPanel></Border><Border Background="{StaticResource Panel2}" Padding="18"><StackPanel><TextBlock Text="FAILED DELIVERIES" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding FailedDeliveries}" FontSize="32" Foreground="{StaticResource Danger}"/></StackPanel></Border></UniformGrid><Border Background="{StaticResource Panel}" Padding="18"><StackPanel><TextBlock Text="LATEST ERROR" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding LastError}" Foreground="{StaticResource Danger}" FontSize="15"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="TRAFFIC"><DataGrid ItemsSource="{Binding Traffic}" AutoGenerateColumns="False" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="CALLING AE" Binding="{Binding CallingAe}"/><DataGridTextColumn Header="FLOW" Binding="{Binding Destination}"/><DataGridTextColumn Header="IP:PORT" Binding="{Binding Ip}"/><DataGridTextColumn Header="SOP CLASS" Binding="{Binding SopClass}"/><DataGridTextColumn Header="STUDY UID" Binding="{Binding StudyUid}"/><DataGridTextColumn Header="SERIES UID" Binding="{Binding SeriesUid}"/><DataGridTextColumn Header="SOP UID" Binding="{Binding SopUid}"/><DataGridTextColumn Header="SIZE" Binding="{Binding Size}"/><DataGridTextColumn Header="DURATION" Binding="{Binding Duration}"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}"/></DataGrid.Columns></DataGrid></TabItem>
<TabItem Header="ROUTING"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="SAVE CONFIGURATION" Command="{Binding SaveConfigurationCommand}"/><TextBlock Text="Drag nodes to persist the visual routing layout." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel><local:RouteGraphCanvas Grid.Row="1" Nodes="{Binding GraphNodes}" Edges="{Binding GraphEdges}" Margin="0,10,0,0"/></Grid></TabItem>
<TabItem Header="LISTENERS"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button Content="+ ADD LISTENER" Command="{Binding AddListenerCommand}"/><Button Content="DELETE" Command="{Binding DeleteListenerCommand}"/><Button Content="START FIRST" Command="{Binding StartScpCommand}"/><Button Content="STOP ALL" Command="{Binding StopScpCommand}"/><Button Content="SAVE" Command="{Binding SaveConfigurationCommand}"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Listeners}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="NAME" Binding="{Binding Name}"/><DataGridTextColumn Header="ENDPOINT" Binding="{Binding Endpoint}"/><DataGridTextColumn Header="CALLED AE" Binding="{Binding AeTitle}"/><DataGridCheckBoxColumn Header="ENABLED" Binding="{Binding Configuration.Enabled}"/><DataGridCheckBoxColumn Header="AUTOSTART" Binding="{Binding Configuration.AutoStart}"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}"/><DataGridTextColumn Header="ASSOCIATIONS" Binding="{Binding Associations}"/><DataGridTextColumn Header="IMAGES" Binding="{Binding ImagesReceived}"/><DataGridTextColumn Header="LAST ERROR" Binding="{Binding LastError}" Width="3*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
<TabItem Header="RULES"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button Content="+ NEW RULE" Command="{Binding AddRuleCommand}"/><Button Content="DELETE" Command="{Binding DeleteRuleCommand}"/><Button Content="MOVE UP" Command="{Binding MoveRuleUpCommand}"/><Button Content="MOVE DOWN" Command="{Binding MoveRuleDownCommand}"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Rules}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="ON" Binding="{Binding Enabled}"/><DataGridTextColumn Header="PRIORITY" Binding="{Binding Priority}"/><DataGridTextColumn Header="RULE NAME" Binding="{Binding Name}" Width="1.2*"/><DataGridTextColumn Header="EXPRESSION (AND / OR / NOT)" Binding="{Binding Expression}" Width="3*"/><DataGridTextColumn Header="DESTINATION" Binding="{Binding Destination}"/><DataGridTextColumn Header="OPERATORS" Binding="{Binding Operators}" Width="2*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
<TabItem Header="DESTINATIONS"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button Content="+ ADD DESTINATION" Command="{Binding AddDestinationCommand}"/><Button Content="REMOVE" Command="{Binding DeleteDestinationCommand}"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Destinations}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="NAME" Binding="{Binding Name}"/><DataGridTextColumn Header="AE TITLE" Binding="{Binding AeTitle}"/><DataGridTextColumn Header="HOST" Binding="{Binding Host}" Width="2*"/><DataGridTextColumn Header="PORT" Binding="{Binding Port}"/><DataGridCheckBoxColumn Header="TLS" Binding="{Binding UseTls}"/><DataGridTemplateColumn Header="TEST"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="C-ECHO" Command="{Binding DataContext.TestEchoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></TabItem>
<TabItem Header="SPOOL / QUEUE"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button Content="RETRY ALL" Command="{Binding RetryAllCommand}"/><Button Content="RETRY" Command="{Binding RetryCommand}"/><Button Content="CANCEL" Command="{Binding CancelCommand}"/><Button Content="SEND TO..."/><Button Content="OPEN METADATA"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Spool}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="STATE" Binding="{Binding State}"/><DataGridTextColumn Header="SOP INSTANCE" Binding="{Binding SopUid}" Width="2*"/><DataGridTextColumn Header="DESTINATION" Binding="{Binding Destination}"/><DataGridTextColumn Header="ATTEMPTS" Binding="{Binding Attempts}"/><DataGridTextColumn Header="NEXT RETRY" Binding="{Binding NextRetry}"/><DataGridTextColumn Header="LAST ERROR" Binding="{Binding Error}" Width="3*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
<TabItem Header="INSPECTOR"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBox Text="{Binding InspectorFilter, UpdateSourceTrigger=PropertyChanged}" Width="350" Padding="8"/><TextBlock Text="  Search tag, name or value · green rows were used in routing" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding InspectorTags}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="TAG" Binding="{Binding Tag}"/><DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="VALUE" Binding="{Binding Value}" Width="3*"/><DataGridCheckBoxColumn Header="USED IN ROUTING" Binding="{Binding UsedInRouting}"/></DataGrid.Columns></DataGrid></Grid></TabItem>
<TabItem Header="TOOLS"><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Text="DICOM TEST TOOLS" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="C-ECHO" Foreground="{StaticResource Muted}" Margin="0,18,0,4"/><WrapPanel><TextBox Text="{Binding TestHost}" Width="180" Padding="7"/><TextBox Text="{Binding TestPort}" Width="75" Padding="7" Margin="6,0,0,0"/><TextBox Text="{Binding TestAeTitle}" Width="120" Padding="7" Margin="6,0,0,0"/></WrapPanel><Button Content="SEND C-ECHO" Command="{Binding TestEchoCommand}" Margin="0,10,0,20" HorizontalAlignment="Left"/><TextBlock Text="OPEN LOCAL .DCM" Foreground="{StaticResource Muted}"/><WrapPanel><TextBox Text="{Binding TestFilePath}" Width="380" Padding="7"/><Button Content="OPEN" Command="{Binding OpenFileCommand}" Margin="6,0,0,0"/></WrapPanel><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="DUMP TAGS" Command="{Binding DumpTagsCommand}"/><Button Content="WHICH ROUTES?" Command="{Binding WhichRoutesCommand}"/></StackPanel></StackPanel><Border Grid.Column="1" Background="{StaticResource Panel}" Padding="18"><StackPanel><TextBlock Text="TOOL OUTPUT" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ToolResult}" TextWrapping="Wrap" FontSize="16" Margin="0,12,0,0"/></StackPanel></Border></Grid></TabItem>
<TabItem Header="EVENT LOG"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button Content="PROTOCOL TRACE"/><Button Content="CLEAR"/><TextBlock Text="Association · DIMSE · Routing · Spool · Forwarding · Retry · Error" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Events}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="TIME" Binding="{Binding Time}"/><DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}"/><DataGridTextColumn Header="EVENT" Binding="{Binding Message}" Width="4*"/><DataGridTextColumn Header="LEVEL" Binding="{Binding Level}"/></DataGrid.Columns></DataGrid></Grid></TabItem>
</TabControl><Border Grid.Row="3" Background="#0C1116" Padding="10" Margin="0,14,0,0"><DockPanel><TextBlock Text="{Binding LastError}" Foreground="{StaticResource Muted}"/><TextBlock DockPanel.Dock="Right" Text="native DICOM · Explicit/Implicit VR LE · byte-preserving transport" Foreground="{StaticResource Muted}"/></DockPanel></Border></Grid></Window>
